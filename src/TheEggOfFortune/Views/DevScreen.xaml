<toolkit:Popup x:Class="TheEggOfFortune.Views.DevScreen"
               xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:TheEggOfFortune.ViewModels"
               xmlns:local="clr-namespace:TheEggOfFortune.Views"
               CanBeDismissedByTappingOutsideOfPopup="True"
               Background="Transparent"
               Opacity="0.9">

    <local:DevScreen.BindingContext>
        <vm:DevScreenViewModel/>
    </local:DevScreen.BindingContext>

    <ScrollView Style="{StaticResource EndtextScrollView}" VerticalScrollBarVisibility="Never">
        <StackLayout Margin="16,8,16,24">
            <Label Text="For debug only!" VerticalOptions="Center" HorizontalOptions="Center" FontSize="32" FontAttributes="Bold" />

            <Grid Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                
                <Label Grid.Column="0" Grid.Row="0" Text="Taps:" FontSize="24" VerticalTextAlignment="Center" Margin="0,0,8,0" />
                <Entry Grid.Column="1" Grid.Row="0" MaxLength="5" Text="{Binding Taps}" FontSize="24" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" Keyboard="Numeric" />
            </Grid>

            <Button Text="Close" Command="{Binding CloseCommand}" FontSize="24" MaximumWidthRequest="120" />
        </StackLayout>
    </ScrollView>
    
</toolkit:Popup>